    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "mongodb": "^7.8.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
