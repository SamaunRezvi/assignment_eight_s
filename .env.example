NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string and database name (shared with the client auth layer)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB=studiospace

# Public URL of the Next.js client (CORS allow-list, comma separated for multiple)
CLIENT_ORIGIN=http://localhost:3000

# Secret used to verify the HTTPOnly auth JWT issued by the client auth layer (min 32 chars)
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
AUTH_COOKIE_NAME=studiospace_token

# imgbb API key for server-side image uploads
IMGBB_API_KEY=
